# Copy to .env (never commit .env).
# Eventstream > custom endpoint source > Event Hub tab > Keys > "Connection string-primary key".
# It must end with ;EntityPath=es_...
EVENTSTREAM_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<key-name>;SharedAccessKey=<REPLACE_ME>;EntityPath=<entity>
